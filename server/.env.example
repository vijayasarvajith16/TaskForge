# ─── Server environment variables ─────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskforge?retryWrites=true&w=majority

# JWT secret — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# Port — Render sets this automatically, leave as 3001 for local dev
PORT=3001

# Allowed frontend origin — set to your Vercel URL in production
# Example: https://taskforge.vercel.app
CLIENT_URL=https://your-app.vercel.app

# Escalation cron (every minute by default)
ESCALATION_CRON=*/1 * * * *
ESCALATION_HOURS=0

# Optional: Upstash Redis URL for multi-instance Socket.io (leave blank for single instance)
# Example: rediss://:<password>@<host>:<port>
REDIS_URL=rediss://default:********@peaceful-louse-197476.upstash.io:6379
